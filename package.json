{
  "name": "folio-visibility",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.1",
  "engines": {
    "node": ">=22.13.0",
    "bun": ">=1.4.1"
  },
  "trustedDependencies": [
    "esbuild",
    "workerd"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "test:gui": "playwright test",
    "db:migrate:local": "node scripts/local-db.mjs migrate",
    "db:status:local": "node scripts/local-db.mjs status",
    "db:backup:local": "node scripts/local-db.mjs backup",
    "test:d1": "node --conditions=react-server --import tsx --test --test-concurrency=1 tests/d1-runtime.integration.ts tests/search-console-d1.integration.ts tests/keyword-benchmark-d1.integration.ts tests/agent-api-d1.integration.ts tests/question-suites-d1.integration.ts tests/keyword-hold-release-d1.integration.ts tests/seo-mcp-d1.integration.ts tests/public-keyword-d1.integration.ts tests/provider-costs-d1.integration.ts tests/typesafe-review-d1.integration.ts tests/typesafe-tool-d1.integration.ts tests/website-crawl-d1.integration.ts tests/onboarding-d1.integration.ts tests/onboarding-customer-groups-d1.integration.ts tests/product-analytics-d1.integration.ts tests/website-changes-d1.integration.ts tests/index-asks-d1.integration.ts tests/website-gaps-d1.integration.ts tests/organizations-d1.integration.ts",
    "benchmark": "node --conditions=react-server --import tsx scripts/keyword-benchmark.ts",
    "rankings:collect": "node --conditions=react-server --import tsx scripts/collect-public-search-rankings.ts",
    "index:evaluate": "node --conditions=react-server --import tsx scripts/evaluate-developer-tools.ts",
    "cf:build": "opennextjs-cloudflare build",
    "frontend:build": "wrangler deploy --config wrangler.frontend.jsonc --env=\"\" --dry-run",
    "frontend:smoke": "node scripts/frontend-runtime-smoke.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "setup": "node scripts/setup-local.mjs",
    "seo:approve": "node scripts/approve-seo-user.mjs",
    "agents:approve": "node scripts/approve-agent-user.mjs",
    "eval:verify": "tsx scripts/verify-evaluation.ts",
    "scheduler:build": "wrangler deploy --config wrangler.scheduler.jsonc --dry-run",
    "scheduler:deploy": "wrangler deploy --config wrangler.scheduler.jsonc",
    "backend:build": "wrangler deploy --config wrangler.production.jsonc --dry-run",
    "backend:smoke": "FOLIO_SMOKE_ENTRY=backend node scripts/frontend-runtime-smoke.mjs",
    "design:check": "impeccable detect src/components src/app",
    "design:live": "impeccable detect http://localhost:3000",
    "design:install": "impeccable install --yes --project --no-hooks",
    "analytics:migrate:local": "wrangler d1 migrations apply ANALYTICS_DB --local --persist-to .wrangler/state",
    "state:audit": "node scripts/state-machine-audit.mjs",
    "proofs:check": "lake --dir proofs build --wfail"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "latest",
    "@codegraff/sdk": "^0.5.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@opennextjs/cloudflare": "1.20.16",
    "@radix-ui/react-select": "2.3.8",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "better-auth": "latest",
    "clsx": "^2.1.1",
    "cuelume": "0.2.8",
    "drizzle-orm": "latest",
    "jszip": "^3.10.1",
    "lucide-react": "latest",
    "motion": "latest",
    "next": "16.4.5",
    "pg": "8.16.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.0.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@playwright/test": "latest",
    "@types/node": "^22.0.0",
    "@types/pg": "8.15.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "impeccable": "^4.8.1",
    "miniflare": "5.20261104.0-beta",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "wrangler": "4.158.0"
  },
  "overrides": {
    "postcss": "^8.5.28"
  }
}
